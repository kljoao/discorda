# Local development only. Copy to .env and choose a local password.
POSTGRES_PASSWORD=replace-with-a-local-development-password
# .NET does not load this file automatically. Use user-secrets or an environment variable.
# ConnectionStrings__Database=Host=127.0.0.1;Port=54322;Database=discorda;Username=discorda_dev;Password=...;Maximum Pool Size=10
# Packaged desktop requires an HTTPS endpoint set by the launch environment.
# DISCORDA_API_URL=https://api.your-domain.example
# Supabase__Url and Supabase__PublishableKey belong in .NET configuration/user-secrets.
# Do not place database credentials or service_role keys in desktop/Vite environment variables.
