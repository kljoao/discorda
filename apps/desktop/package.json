{
  "name": "@discorda/desktop",
  "version": "0.13.0",
  "private": true,
  "description": "Seu grupo, no mesmo lugar.",
  "author": "Discorda",
  "type": "module",
  "main": "dist/main/index.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && node scripts/build-electron.mjs && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:desktop": "playwright test",
    "package:win": "npm run build:audio && npm run build && electron-builder --win nsis --x64 --publish never --config.directories.output=release/community && node scripts/check-package.mjs release/community/win-unpacked",
    "package:release": "node scripts/package-release.mjs",
    "build:audio": "pwsh -NoProfile -ExecutionPolicy Bypass -File ../../tools/build-windows-audio.ps1"
  },
  "dependencies": {
    "@microsoft/signalr": "10.0.11",
    "@radix-ui/react-slot": "1.3.3",
    "@supabase/supabase-js": "2.117.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "electron-updater": "6.8.9",
    "livekit-client": "2.22.3",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "undici": "8.11.2",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
